# FounderLens AI — example environment configuration.
# Copy to `.env` (backend) and fill in real values. Never commit `.env`.

# --- Application ------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Application database (Supabase Postgres) -------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=replace-me
# Server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Signs and verifies auth tokens. Server-side only.
# Local stack: `supabase status` prints it. Hosted: Settings > API > JWT Secret.
SUPABASE_JWT_SECRET=replace-me
SUPABASE_JWT_AUDIENCE=authenticated

# --- Document storage -------------------------------------------------------
DOCUMENTS_BUCKET=research-documents
# 25 MiB. Keep in step with the bucket's own file_size_limit.
MAX_DOCUMENT_BYTES=26214400

# --- Ingestion --------------------------------------------------------------
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
TOKENIZER_ENCODING=cl100k_base

# --- Neo4j ------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-me
NEO4J_DATABASE=neo4j

# --- LLM provider -----------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=replace-me

# --- Embedding provider -----------------------------------------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Separate from LLM_API_KEY: embedding and generation can be different accounts.
EMBEDDING_API_KEY=replace-me
# Point at any OpenAI-compatible endpoint.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_BATCH_SIZE=64
