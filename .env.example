# FounderLens AI — example environment configuration.
# Copy to `.env` (backend) and fill in real values. Never commit `.env`.

# --- Application ------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Application database (Supabase Postgres) -------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=replace-me
# Server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Signs and verifies auth tokens. Server-side only.
# Local stack: `supabase status` prints it. Hosted: Settings > API > JWT Secret.
SUPABASE_JWT_SECRET=replace-me
SUPABASE_JWT_AUDIENCE=authenticated

# --- Neo4j ------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-me

# --- LLM provider -----------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=replace-me

# --- Embedding provider -----------------------------------------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
