# Frontend environment. Only NEXT_PUBLIC_* values reach the browser --
# never place service-role keys or provider API keys in this file.
#
# Copy to .env.local. The anon key is safe to expose: on its own it grants
# nothing, because every table is protected by row-level security.

NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# Base URL of the FounderLens API (the FastAPI service).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
